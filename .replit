modules = ["nodejs-24", "postgresql-16"]
  [nix]
  channel = "stable-25_05"
  packages = ["unzip"]

  [agent]
expertMode = true
integrations = ["javascript_database:1.0.0"]

  [[mcp.servers]]
  name = "supabase"
  command = "npx"
  args = ["-y", "@supabase/mcp-server-supabase@latest", "--access-token", "sbp_be0aab3bca75dfe3aed08120a935d14325140cb2", "--project-ref", "hbekmqzdoxcsznykuxdj"]

  [workflows]

  [userenv]

  [userenv.shared]
EXPO_PUBLIC_SUPABASE_URL = "https://hbekmqzdoxcsznykuxdj.supabase.co"
PORT = "5000"
EXPO_METRO_PORT = "22861"
NODE_ENV = "development"
EXPO_PUBLIC_EAS_PROJECT_ID = "e73f6f13-4f20-4ee3-979d-ee9435474236"

[[ports]]
