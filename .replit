modules = ["nodejs-24", "postgresql-16"]
  [nix]
  channel = "stable-25_05"
  packages = ["unzip"]

  [agent]
expertMode = true
integrations = ["javascript_database:1.0.0"]

  [[mcp.servers]]
  name = "supabase"
  command = "npx"
  args = ["-y", "@supabase/mcp-server-supabase@latest", "--access-token", "sbp_d5f1e9a42ebf753b39d8b5c66cc6ee51b5130cbb", "--project-ref", "hbekmqzdoxcsznykuxdj"]

  [workflows]
runButton = "Project"

  [[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

  [[workflows.workflow]]
name = "Start application"
author = "agent"

  [workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/khrono/server/expo-proxy.js & PORT=5000 pnpm --filter @workspace/khrono run dev"
waitForPort = 5000

  [userenv]

  [userenv.shared]
EXPO_PUBLIC_SUPABASE_URL = "https://hbekmqzdoxcsznykuxdj.supabase.co"
PORT = "5000"
EXPO_METRO_PORT = "22861"
NODE_ENV = "development"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22862
externalPort = 3001
  