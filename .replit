  args = ["-y", "@supabase/mcp-server-supabase@latest", "--access-token", "sbp_d5f1e9a42ebf753b39d8b5c66cc6ee51b5130cbb", "--project-ref", "hbekmqzdoxcsznykuxdj"]

  [workflows]
runButton = "Project"

  [[workflows.workflow]]
